cabal-version:      2.4
name:               adventure
version:            0.1.0.0
synopsis:           Functional text adventure engine
license:            BSD-3-Clause
author:             Your Name
maintainer:         your@email.com
build-type:         Simple

executable adventure
    main-is:          Main.hs
    other-modules:    Types
                    , World
                    , Parser
                    , Evaluator
                    , Loader
                    , Pretty
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:  base ^>=4.18
                    , containers
                    , text
                    , directory

test-suite adventure-tests
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    default-language: Haskell2010
    build-depends:    base ^>=4.17
                    , containers
                    , adventure
                    , HUnit